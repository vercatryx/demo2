# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (NEW project only — from Supabase dashboard or MCP)
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Legacy service_role JWT and/or new secret key (sb_secret_...) from Supabase dashboard
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
# Optional: direct Postgres URL bypasses REST API (recommended when legacy keys are disabled)
DATABASE_URL=

# Auth (custom JWT — staff sessions, not Supabase Auth)
JWT_SECRET=

# Bootstrap super-admin (demo login — server-side only, not NEXT_PUBLIC_*)
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Aliases also supported:
ENV_ADMIN_USERNAME=
ENV_ADMIN_PASSWORD=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_DELIVERY_BUCKET_NAME=
NEXT_PUBLIC_R2_DOMAIN=

# Chrome extension API
EXTENSION_API_KEY=

# Local AI (optional — AI Builder prompt testing)
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Client invoice footer (HTML receipt + /api/client-invoice-pdf). All NEXT_PUBLIC_* are optional.
