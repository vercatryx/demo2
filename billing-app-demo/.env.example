# --- Unite Us credentials (optional — can also set in Advanced settings in the app) ---
UNITEUS_EMAIL=
UNITEUS_PASSWORD=

# Brooklyn account (when Account dropdown is Brooklyn)
UNITEUS_EMAIL_BROOKLYN=your-brooklyn-email@example.com
UNITEUS_PASSWORD_BROOKLYN=your-brooklyn-password

# --- Demo API (Client Food Service at scn.demo.poel.ai) ---
# Must match EXTENSION_API_KEY on the Next.js demo app if you use update-status callbacks.
EXTENSION_API_KEY=your-api-key
EXTENSION_API_BASE_URL=https://scn.demo.poel.ai

# Browser slots and headless mode (editable in dashboard → Save settings)
CONCURRENT_BROWSERS=4
HEADLESS=true

# --- Demo / screen recording safety ---
DEMO_SAFE_QUEUE=true
DEMO_QUEUE_LIMIT=20
DEMO_ANONYMIZE_PATIENT_UI=true
DEMO_SKIP_BILLING_SUBMIT=true
DEMO_PAUSE_MS=6000
